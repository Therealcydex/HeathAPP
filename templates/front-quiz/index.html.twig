{# templates/front-quiz/index.html.twig #}
{% extends 'base-front.html.twig' %}

{% block title %}Select a Quiz{% endblock %}

{% block body %}
    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-body">
                        <h3 class="card-title text-center mb-4">
                            <i class="mdi mdi-book-open-variant"></i> Select a Quiz
                        </h3>

                        <!-- Formulaire de recherche (non-AJAX de base) -->
                        <form method="GET" action="{{ path('app_front_quiz_index') }}" class="mb-3">
                            <div class="input-group">
                                <input type="text" name="search" value="{{ searchTerm }}" class="form-control"
                                       placeholder="Search for a quiz..." aria-label="Search" id="quiz-search-input">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-primary" type="submit" id="search-btn">Search</button>
                                    {% if searchTerm %}
                                        <a href="{{ path('app_front_quiz_index') }}" class="btn btn-outline-danger">Clear</a>
                                    {% endif %}
                                </div>
                            </div>
                        </form>

                        <!-- Conteneur dynamique pour les quizzes -->
                        <div id="quiz-list-container">
                            {# Inclusion initiale des quizzes #}
                            {% include 'front-quiz/_quiz_list.html.twig' with {'quizzes': quizzes} %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# CSS optionnel #}
    <style>
        .quiz-item {
            font-size: 1.1rem;
            padding: 15px;
            transition: all 0.3s ease-in-out;
            border-radius: 8px;
        }
        .quiz-item:hover {
            background: #f8f9fa;
            transform: scale(1.02);
        }
        .badge {
            font-size: 0.9rem;
            padding: 8px 12px;
        }
        .card {
            border-radius: 12px;
            overflow: hidden;
        }
        .container {
            padding-bottom: 60px;
        }
    </style>

    {# Script JavaScript pour la recherche AJAX #}
    <script>
        const searchInput = document.getElementById('quiz-search-input');
        const searchButton = document.getElementById('search-btn');
        const quizListContainer = document.getElementById('quiz-list-container');

        /**
         * Fonction pour appeler la route AJAX et mettre à jour la liste des quizzes
         * @param {string} searchValue
         */
        function fetchQuizzes(searchValue = '') {
            // Construire l'URL : /quiz/front-search?search=...
            const url = new URL('{{ path('app_front_quiz_search') }}', window.location.origin);
            url.searchParams.append('search', searchValue);

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text(); // On veut du HTML
                })
                .then(html => {
                    // Injecter le HTML dans le conteneur
                    quizListContainer.innerHTML = html;
                })
                .catch(error => {
                    console.error('Error fetching quizzes (front):', error);
                });
        }

        
        searchButton.addEventListener('click', (e) => {
            e.preventDefault(); 
            fetchQuizzes(searchInput.value);
        });

        searchInput.addEventListener('keyup', () => {
            fetchQuizzes(searchInput.value);
        });
    </script>
{% endblock %}
