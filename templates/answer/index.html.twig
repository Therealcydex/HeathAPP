{% extends 'base.html.twig' %}

{% block title %}Answer Index{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <div class="clearfix">
                <h4 class="card-title float-left">Answer List</h4>
                <a href="{{ path('app_answer_new') }}" class="btn btn-gradient-primary float-right">
                    <i class="mdi mdi-plus"></i> Create New Answer
                </a>
            </div>

            <!-- Search Form -->
            <form method="GET" action="#" class="mt-3" id="search-form" onsubmit="return false;">
                <div class="input-group">
                    <input type="text" name="search" id="search-input" value="{{ searchTerm }}" class="form-control"
                           placeholder="Search answers or questions..." aria-label="Search">
                    <div class="input-group-append">
                        {% if searchTerm %}
                            <a href="{{ path('app_answer_index') }}" class="btn btn-outline-danger">Clear</a>
                        {% endif %}
                    </div>
                </div>
            </form>

            <div class="table-responsive mt-4" id="answers-container">
                {% include 'answer/_answer_list.html.twig' %}
            </div>
            <!-- Pagination -->
            <div id="pagination-container" class="mt-3">
                {% include 'answer/_pagination.html.twig' %}
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('search-input');
            const answersContainer = document.getElementById('answers-container');
            let debounceTimer;

            function fetchAnswers(queryParams) {
                fetch('{{ path('app_answer_search') }}' + '?' + new URLSearchParams(queryParams))
                    .then(response => response.json())
                    .then(data => {
                        answersContainer.innerHTML = data.html;
                        attachSortingEvents();
                    })
                    .catch(error => console.error('Error:', error));
            }

            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    fetchAnswers({ search: searchInput.value });
                }, 300); // Debounce to prevent excessive requests
            });

            function attachSortingEvents() {
                document.querySelectorAll('.sort-link').forEach(link => {
                    link.addEventListener('click', function(event) {
                        event.preventDefault();
                        const sortField = this.dataset.sort;
                        const sortOrder = this.dataset.order;
                        fetchAnswers({ search: searchInput.value, sort: sortField, order: sortOrder });
                    });
                });
            }

            attachSortingEvents();
        });
    </script>
{% endblock %}