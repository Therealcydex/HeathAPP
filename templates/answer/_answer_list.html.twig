<table class="table table-hover w-100" style="table-layout: fixed;">
    <thead class="table-light">
        <tr>
            <th>
                <a href="#" class="sort-link" data-sort="q.text" data-order="{{ sortOrder == 'asc' ? 'desc' : 'asc' }}">
                    Question
                </a>
            </th>
            <th>
                <a href="#" class="sort-link" data-sort="text" data-order="{{ sortOrder == 'asc' ? 'desc' : 'asc' }}">
                    Answer
                </a>
            </th>
            <th>
                <a href="#" class="sort-link" data-sort="isCorrect" data-order="{{ sortOrder == 'asc' ? 'desc' : 'asc' }}">
                    Is Correct
                </a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for answer in answers %}
            <tr>
                <td>{{ answer.question.text }}</td>
                <td>{{ answer.text }}</td>
                <td>
                    {% if answer.isCorrect %}
                        <span class="badge badge-success">Yes</span>
                    {% else %}
                        <span class="badge badge-danger">No</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_answer_show', {'id': answer.id}) }}" class="btn btn-info btn-sm">
                        <i class="mdi mdi-eye"></i> Show
                    </a>
                    <a href="{{ path('app_answer_edit', {'id': answer.id}) }}" class="btn btn-warning btn-sm">
                        <i class="mdi mdi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">No records found</td>
            </tr>
        {% endfor %}
    </tbody>
</table>