{% extends 'base.html.twig' %}

{% block title %}Question Index{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <div class="clearfix">
                <h4 class="card-title float-left">Question List</h4>
                <a href="{{ path('app_question_new') }}" class="btn btn-gradient-primary float-right">
                    <i class="mdi mdi-plus"></i> Create New Question
                </a>
            </div>

            <!-- Search Form -->
            <form method="GET" action="{{ path('app_question_index') }}" class="mt-3">
                <div class="input-group">
                    <input type="text" name="search" value="{{ searchTerm }}" class="form-control"
                           placeholder="Search questions or quizzes..." aria-label="Search">
                    <div class="input-group-append">
                        <button class="btn btn-outline-primary" type="submit">Search</button>
                        {% if searchTerm %}
                            <a href="{{ path('app_question_index') }}" class="btn btn-outline-danger">Clear</a>
                        {% endif %}
                    </div>
                </div>
            </form>

            <div class="table-responsive mt-4">
                <table class="table table-hover w-100" style="table-layout: fixed;">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a href="{{ path('app_question_index', {'sort': 'text', 'order': sortOrder == 'asc' ? 'desc' : 'asc'}) }}">
                                    Question
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_question_index', {'sort': 'quiz.name', 'order': sortOrder == 'asc' ? 'desc' : 'asc'}) }}">
                                    Quiz
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for question in questions %}
                            <tr>
                                <td>{{ question.text }}</td>
                                <td>
                                    <span class="badge badge-info">{{ question.quiz.name }}</span>
                                </td>
                                <td>
                                    <a href="{{ path('app_question_show', {'id': question.id}) }}" class="btn btn-info btn-sm">
                                        <i class="mdi mdi-eye"></i> Show
                                    </a>
                                    <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="mdi mdi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center">No records found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
