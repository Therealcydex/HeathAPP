{% extends 'base.html.twig' %}

{% block title %}Question Index{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <div class="clearfix">
                <h4 class="card-title float-left">Question List</h4>
                <a href="{{ path('app_question_new') }}" class="btn btn-gradient-primary float-right">
                    <i class="mdi mdi-plus"></i> Create New Question
                </a>
            </div>

            <!-- Search Form -->
            <form method="GET" action="#" class="mt-3" id="search-form" onsubmit="return false;">
                <div class="input-group">
                    <input type="text" name="search" id="search-input" value="{{ searchTerm }}" class="form-control"
                           placeholder="Search questions or quizzes..." aria-label="Search">
                    <div class="input-group-append">
                        {% if searchTerm %}
                            <a href="{{ path('app_question_index') }}" class="btn btn-outline-danger">Clear</a>
                        {% endif %}
                    </div>
                </div>
            </form>

            <div class="table-responsive mt-4" id="questions-container">
                {% include 'question/_question_list.html.twig' %}
            </div>

            <!-- Pagination -->
            <div id="pagination-container" class="mt-3">
                {% include 'question/_pagination.html.twig' %}
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('search-input');
            const questionsContainer = document.getElementById('questions-container');
            const paginationContainer = document.getElementById('pagination-container');
            let debounceTimer;

            function fetchQuestions(queryParams) {
                fetch('{{ path('app_question_search') }}' + '?' + new URLSearchParams(queryParams))
                    .then(response => response.json())
                    .then(data => {
                        questionsContainer.innerHTML = data.html;
                        paginationContainer.innerHTML = data.pagination;
                        attachSortingEvents();
                        attachPaginationEvents();
                    })
                    .catch(error => console.error('Error:', error));
            }

            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    fetchQuestions({ search: searchInput.value });
                }, 300);
            });

            function attachSortingEvents() {
                document.querySelectorAll('.sort-link').forEach(link => {
                    link.addEventListener('click', function(event) {
                        event.preventDefault();
                        const sortField = this.dataset.sort;
                        const sortOrder = this.dataset.order;
                        fetchQuestions({ search: searchInput.value, sort: sortField, order: sortOrder });
                    });
                });
            }

            function attachPaginationEvents() {
                document.querySelectorAll('.page-link').forEach(link => {
                    link.addEventListener('click', function(event) {
                        event.preventDefault();
                        const urlParams = new URL(this.href).searchParams;
                        fetchQuestions({
                            search: urlParams.get('search'),
                            sort: urlParams.get('sort'),
                            order: urlParams.get('order'),
                            page: urlParams.get('page'),
                        });
                    });
                });
            }

            attachSortingEvents();
            attachPaginationEvents();
        });
    </script>
{% endblock %}
