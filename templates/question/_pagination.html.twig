{% if pagination is defined and pagination.totalPages > 1 %}
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            {% if pagination.currentPage > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_question_index', {'page': pagination.currentPage - 1, 'search': searchTerm, 'sort': sortField, 'order': sortOrder}) }}">Previous</a>
                </li>
            {% endif %}

            {% for page in 1..pagination.totalPages %}
                <li class="page-item {{ page == pagination.currentPage ? 'active' : '' }}">
                    <a class="page-link" href="{{ path('app_question_index', {'page': page, 'search': searchTerm, 'sort': sortField, 'order': sortOrder}) }}">{{ page }}</a>
                </li>
            {% endfor %}

            {% if pagination.currentPage < pagination.totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_question_index', {'page': pagination.currentPage + 1, 'search': searchTerm, 'sort': sortField, 'order': sortOrder}) }}">Next</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
