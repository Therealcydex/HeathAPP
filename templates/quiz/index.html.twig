{% extends 'base.html.twig' %}

{% block title %}Quiz Index{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
        <h4 class="card-title float-left">Quiz List</h4>
            <div class="d-flex justify-content-between align-items-center">
            
                <div class="clearfix">
                    
                    <a href="{{ path('app_quiz_new') }}" class="btn btn-gradient-primary float-right">
                        <i class="mdi mdi-plus"></i> Create New Quiz
                    </a>
                </div>
                <div>
                    <a href="{{ path('app_quiz_export_pdf') }}" class="btn btn-primary">
                        Export Quizzes to PDF
                    </a>
                </div>
            </div>


            <!-- Search Form -->
            <form method="GET" action="{{ path('app_quiz_index') }}" class="mt-3">
                <div class="input-group">
                    <input type="text" name="search" value="{{ searchTerm }}" class="form-control"
                        placeholder="Search quizzes..." aria-label="Search">
                    <div class="input-group-append">
                        <button class="btn btn-outline-primary" type="submit">Search</button>
                        {% if searchTerm %}
                            <a href="{{ path('app_quiz_index') }}" class="btn btn-outline-danger">Clear</a>
                        {% endif %}
                    </div>
                </div>
            </form>

            <div class="table-responsive mt-4">
                <table class="table table-hover w-100" style="table-layout: fixed;">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a href="{{ path('app_quiz_index', {'sort': 'name', 'order': sortOrder == 'asc' ? 'desc' : 'asc'}) }}">
                                    Quiz Name
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_quiz_index', {'sort': 'type', 'order': sortOrder == 'asc' ? 'desc' : 'asc'}) }}">
                                    Quiz Type
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quiz in quizzes %}
                            <tr>
                                <td class="text-truncate">{{ quiz.name }}</td>
                                <td class="text-truncate">{{ quiz.type.value }}</td>
                                <td>
                                    <a href="{{ path('app_quiz_show', {'id': quiz.id}) }}" class="btn btn-info btn-sm">
                                        <i class="mdi mdi-eye"></i> Show
                                    </a>
                                    <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="mdi mdi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center">No quizzes found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
