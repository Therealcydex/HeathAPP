{% extends 'base-front.html.twig' %}

{% block title %}View Appointments{% endblock %}

{% block body %}
    <h1 style="font-size: 2em; font-weight: bold; margin-bottom: 20px; color: #333;">Your Appointments</h1>

    <!-- 🔍 Search Bar (AJAX) -->
    <div style="text-align: center; margin-bottom: 20px;">
        <input type="text" id="search-input" placeholder="Search appointments..." 
               style="padding: 10px; width: 300px; border: 1px solid #ddd; border-radius: 5px;">
    </div>

    <!-- 📝 Appointment List -->
    <div id="appointments-list" style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;">
        {% for appointment in appointments %}
            <div class="appointment-item" data-id="{{ appointment.id }}"
                 data-client="{{ appointment.clientName }}" data-doctor="{{ appointment.doctor ? appointment.doctor.name : '' }}"
                 style="background-color: #fff; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); padding: 20px; width: 33%; margin: 0 auto;">
                <h3 style="font-size: 1.5em; color: #007bff; margin-bottom: 10px;">
                    {{ appointment.clientName }} - 
                    {% if appointment.doctor %}
                        {{ appointment.doctor.name }}
                    {% else %}
                        No Doctor Assigned
                    {% endif %}
                </h3>
                <p style="font-size: 1.1em; margin-bottom: 10px;">Appointment Date: <strong>{{ appointment.appointmentDate ? appointment.appointmentDate|date('Y-m-d') : 'N/A' }}</strong></p>
                
                <!-- 🏥 Prescriptions -->
                <div style="margin-bottom: 15px;">
                    {% if appointment.prescriptions is not empty %}
                        <div style="color: #28a745;">
                            <h4 style="margin-bottom: 10px;">Prescriptions:</h4>
                            <ul style="list-style-type: none; padding-left: 0;">
                                {% for prescription in appointment.prescriptions %}
                                    <li>
                                        <a href="{{ path('view_prescription', {'id': prescription.id}) }}" class="view-prescription" data-id="{{ prescription.id }}" 
                                           style="color: #007bff; text-decoration: underline;">View Prescription</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                        <div style="color: #28a745;">
                            <a href="{{ path('add_prescription', {'appointmentId': appointment.id}) }}" class="add-prescription" 
                               style="color: #28a745; text-decoration: underline;">Add Prescription</a>
                        </div>
                    {% endif %}
                </div>

                <!-- ❌ Cancel Appointment Button -->
                <div>
                    <form class="cancel-form" data-id="{{ appointment.id }}" action="{{ path('app_appointment_delete', {'id': appointment.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                        <button type="submit" style="background-color: #dc3545; color: #fff; padding: 8px 15px; border: none; border-radius: 5px; cursor: pointer; transition: background-color 0.3s; width: 100%;">Cancel Appointment</button>
                    </form>
                </div>
            </div>
        {% else %}
            <p id="no-results" style="color: #888; text-align: center;">No appointments available.</p>
        {% endfor %}
    </div>

    <!-- ➕ Book a New Appointment Button -->
    <div>
        <a href="{{ path('book_appointment') }}" style="background-color: #007bff; color: #fff; padding: 12px 25px; border-radius: 5px; text-decoration: none; font-weight: bold; transition: background-color 0.3s; display: inline-block; width: 100%; text-align: center;">Book a New Appointment</a>
    </div>

    <!-- 📄 Pagination Controls -->
    <div id="pagination-controls" style="display: flex; justify-content: center; margin-top: 20px;">
        {% if currentPage > 1 %}
            <a href="{{ path('view_appointments', {'page': currentPage - 1}) }}" style="margin-right: 10px; padding: 10px 15px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">Previous</a>
        {% endif %}

        <span style="padding: 10px 15px; border: 1px solid #ccc; background-color: #f8f9fa; border-radius: 5px;">
            Page {{ currentPage }} of {{ totalPages }}
        </span>

        {% if currentPage < totalPages %}
            <a href="{{ path('view_appointments', {'page': currentPage + 1}) }}" style="margin-left: 10px; padding: 10px 15px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">Next</a>
        {% endif %}
    </div>

    <!-- 🔍 AJAX Search Script with Event Delegation -->
    <script>
        document.getElementById('search-input').addEventListener('input', function () {
            let query = this.value.trim();

            if (query.length === 0) {
                location.reload(); // Reset if input is empty
                return;
            }

            fetch(`/appointment/view?search=${query}`)
                .then(response => response.json())
                .then(data => {
                    let appointmentList = document.getElementById('appointments-list');
                    let paginationControls = document.getElementById('pagination-controls');
                    appointmentList.innerHTML = ''; // Clear existing
                    paginationControls.style.display = 'none'; // Hide pagination when searching

                    if (data.appointments.length === 0) {
                        appointmentList.innerHTML = '<p id="no-results" style="color: #888; text-align: center;">No results found.</p>';
                    }

                    data.appointments.forEach(appointment => {
                        appointmentList.innerHTML += `
                            <div class="appointment-item" data-id="${appointment.id}"
                                 style="background-color: #fff; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); padding: 20px; width: 33%; margin: 0 auto;">
                                <h3 style="font-size: 1.5em; color: #007bff; margin-bottom: 10px;">
                                    ${appointment.clientName} - ${appointment.doctorName}
                                </h3>
                                <p style="font-size: 1.1em; margin-bottom: 10px;">Appointment Date: <strong>${appointment.appointmentDate}</strong></p>
                                <div style="color: #28a745;">
                                    <a href="/prescription/add/${appointment.id}" class="add-prescription"
                                       style="color: #28a745; text-decoration: underline;">Add Prescription</a>
                                </div>
                                <form class="cancel-form" data-id="${appointment.id}" action="/appointment/${appointment.id}/delete" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                                    <button type="submit" style="background-color: #dc3545; color: #fff; padding: 8px 15px; border: none; border-radius: 5px; cursor: pointer; transition: background-color 0.3s; width: 100%;">Cancel Appointment</button>
                                </form>
                            </div>`;
                    });

                    attachEventListeners(); // Reattach events to new elements
                });
        });

        function attachEventListeners() {
            document.addEventListener('click', function(event) {
                if (event.target.matches('.cancel-form button')) {
                    event.preventDefault();
                    let form = event.target.closest('form');
                    if (confirm('Are you sure you want to delete this appointment?')) {
                        form.submit();
                    }
                }
            });
        }
    </script>

{% endblock %}
