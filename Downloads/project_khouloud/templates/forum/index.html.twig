{% extends 'base.html.twig' %}

                        {% block title %}Forum{% endblock %}

                        {% block body %}
                            <style>
                                dl, ol, ul {
                                    margin-top: 0;
                                    margin-bottom: 0;
                                    color: tomato;
                                }
                                .fa-edit:before, .fa-pencil-square-o:before {
                                    content: "\f044";
                                    color: #1d82e5;
                                }
                                .fa-trash-alt:before, .fa-trash-can:before {
                                    content: "\f2ed";
                                    color: red;
                                }
                                .active-filter {
                                    background-color: #ececec;
                                    color: white;
                                }
                                .h-full {
                                    height: auto;
                                }
                                .menu {
                                    position: relative;
                                    display: inline-block;
                                }
                                .menu-content {
                                    display: none;
                                    position: absolute;
                                    right: 0;
                                    background-color: white;
                                    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
                                    z-index: 1;
                                }
                                .menu-content a {
                                    color: black;
                                    padding: 12px 16px;
                                    text-decoration: none;
                                    display: block;
                                }
                                .menu-content a:hover {
                                    background-color: #f1f1f1;
                                }
                                .menu-content a.delete {
                                    color: red;
                                }
                                .menu-content a.update {
                                    color: green;
                                }
                                .menu:hover .menu-content {
                                    display: block;
                                }
                                .menu span {
                                    font-size: 24px;
                                    opacity: 0.5;
                                    transition: opacity 0.3s;
                                }
                                .menu:hover span {
                                    opacity: 1;
                                }
                                #postModal {
                                    z-index: 9999;
                                }
                                a:visited {
                                    color: #176abc;
                                }

                                #filterMenu {
                                    opacity: 0;
                                    height: 0;
                                    overflow: hidden;
                                    transition: opacity 0.3s ease, height 0.3s ease;
                                }

                                #filterMenu.visible {
                                    display: block;
                                    opacity: 1;
                                    height: auto;
                                }

                                #postsList > div {
                                    transition: opacity 0.3s ease, transform 0.3s ease;
                                }
                                #filterMenu {
                                    position: relative; /* Ensure the button is positioned relative to the menu */
                                    padding-bottom: 4rem; /* Add padding to make space for the button */
                                }

                                #applyFilters {
                                    position: absolute;
                                    bottom: 1rem; /* Position the button at the bottom */
                                    right: 1rem; /* Position the button at the right */
                                }
                                #postsList > div.hidden {
                                    opacity: 0;
                                    transform: translateY(-10px);
                                    height: 0;
                                    margin: 0;
                                    padding: 0;
                                    border: none;
                                    overflow: hidden;
                                }

                                /* No posts found message */
                                #noPostsMessage {
                                    text-align: center;
                                    padding: 20px;
                                    font-size: 1.2rem;
                                    color: #666;
                                }
                            </style>

                            <script src="https://cdn.tailwindcss.com"></script>

                            <body class="bg-white text-[#176abc] h-screen overflow-y-auto">
                                <div class="container mx-auto p-6 w-full h-full relative">
                                    <div class="flex justify-between items-center mb-6">
                                        <h1 class="text-3xl font-bold">Forum</h1>
                                        <!-- Add Post Button -->
                                        <button id="openModal" class="bg-[#176abc] text-white px-4 py-2 rounded-lg hover:bg-[#135a97]">Add New Post</button>
                                    </div>

                                    <!-- Search and Filter Bar -->
                                    <div class="flex items-center space-x-4 mb-6">
                                        <!-- Search Input -->
                                        <input
                                            id="searchInput"
                                            type="text"
                                            placeholder="Search posts..."
                                            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                        />
                                        <!-- Search Button -->
                                        <button
                                            id="searchButton"
                                            class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                                        >
                                            Search
                                        </button>
                                        <!-- Filter Button -->
                                        <button
                                            id="filterButton"
                                            class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2"
                                        >
                                            Filter
                                        </button>
                                    </div>

                                    <!-- Filter Menu (Hidden by Default) -->
                                    <div id="filterMenu" class="mb-6 p-4 bg-white border border-gray-200 rounded-lg shadow-lg">
                                        <div class="flex space-x-6">
                                            <!-- Filter by Category -->
                                            <div class="flex-1">
                                                <h3 class="text-sm font-semibold text-gray-600 mb-2">Filter by Category</h3>
                                                <ul class="space-y-2">
                                                    <li><a href="#" data-filter="category:General Health" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">General Health</a></li>
                                                    <li><a href="#" data-filter="category:Symptoms and Diagnosis" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Symptoms and Diagnosis</a></li>
                                                    <li><a href="#" data-filter="category:Symptoms and Diagnosis" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Medications and Treatments</a></li>
                                                    <li><a href="#" data-filter="category:Medical News" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Medical News</a></li>
                                                </ul>
                                            </div>
                                            <!-- Filter by Role -->
                                            <div class="flex-1">
                                                <h3 class="text-sm font-semibold text-gray-600 mb-2">Filter by Role</h3>
                                                <ul class="space-y-2">
                                                    <li><a href="#" data-filter="role:doctor" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Doctor</a></li>
                                                    <li><a href="#" data-filter="role:patient" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Patient</a></li>
                                                </ul>
                                            </div>
                                            <!-- Filter by Comments -->
                                            <div class="flex-1">
                                                <h3 class="text-sm font-semibold text-gray-600 mb-2">Filter by Comments</h3>
                                                <ul class="space-y-2">
                                                    <li><a href="#" data-filter="comments:most" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Most Comments</a></li>
                                                </ul>
                                            </div>
                                            <!-- Filter by Time -->
                                            <div class="flex-1">
                                                <h3 class="text-sm font-semibold text-gray-600 mb-2">Filter by Time</h3>
                                                <ul class="space-y-2">
                                                    <li><a href="#" data-filter="time:today" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Today</a></li>
                                                    <li><a href="#" data-filter="time:this-week" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">This Week</a></li>
                                                    <li><a href="#" data-filter="time:this-month" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">This Month</a></li>
                                                </ul>
                                            </div>
                                            <!-- Sort by Date -->
                                            <div class="flex-1">
                                                <h3 class="text-sm font-semibold text-gray-600 mb-2">Sort by Date</h3>
                                                <ul class="space-y-2">
                                                    <li><a href="#" data-filter="sort:newest" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Newest to Oldest</a></li>
                                                    <li><a href="#" data-filter="sort:oldest" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Oldest to Newest</a></li>
                                                </ul>
                                            </div>
                                        </div>

                                            <button id="applyFilters" class=" absolute bottom-4 right-4 px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                                <span id="applyFiltersText">Apply Filters</span>
                                                <span id="applyFiltersSpinner" class="hidden ml-2">
                <i class="fas fa-spinner fa-spin"></i> <!-- Font Awesome spinner -->
            </span>
                                            </button>

                                    </div>

                                    <!-- Posts List -->
                                    <div id="postsList" class="space-y-4">
                                        {% for post in posts %}
                                            <div class="block border p-4 rounded-lg shadow bg-gray-100 hover:bg-gray-200 transition relative"
                                                 data-category="{{ post.category }}"
                                                 data-role="{{ post.author.role }}"
                                                 data-comments="{{ post.comments|length }}"
                                                 data-title="{{ post.title|lower }}"
                                                 data-content="{{ post.content|lower }}"
                                                 data-comment-count="{{ post.commentCount }}"
                                                 data-author="{{ (post.author.name ~ ' ' ~ post.author.lastname)|lower }}"
                                                 data-date="{{ post.createdAt|date('Y-m-d H:i:s') }}">
                                                <!-- Post Title and Menu -->
                                                <div class="flex justify-between items-center">
                                                    <a href="{{ path('post_show', {'id': post.id}) }}" class="text-xl font-semibold text-black" id="post-title-{{ post.id }}">{{ post.title }}</a>
                                                    <div class="flex space-x-2">
                                                        <a href="{{ path('post_edit', {'id': post.id}) }}" class="text-green-500 hover:text-green-700">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <a href="{{ path('post_delete', {'id': post.id}) }}" class="text-red-500 hover:text-red-700">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                                <!-- Post Content -->
                                                <p class="text-gray-700 mt-2" id="post-content-{{ post.id }}">{{ post.content }}</p>
                                                <!-- Translate Buttons -->
                                                <div class="mt-2 space-x-2">
                                                    <button onclick="translatePost({{ post.id }}, 'fr')" class="text-blue-500 hover:text-blue-700">
                                                        Translate to French
                                                    </button>
                                                    <button onclick="translatePost({{ post.id }}, 'ar')" class="text-blue-500 hover:text-blue-700">
                                                        Translate to Arabic
                                                    </button>
                                                </div>
                                                <!-- Author, Role, and Date -->
                                                <div class="flex items-center space-x-2 mt-2">
                                                    <p class="text-gray-500 text-sm">Posted by: <strong>{{ post.author.name }} {{ post.author.lastname }}</strong></p>
                                                    <span class="text-xs px-2 py-1 bg-blue-500 text-white rounded-full">{{ post.author.role }}</span>
                                                </div>
                                                <p class="text-gray-500 text-sm mt-2">Posted on: {{ post.createdAt|date_modify('+1 hour')|date('l, d F H:i') }}</p>
                                                <!-- Post Category at Bottom Right -->
                                                <div class="absolute bottom-4 right-4">
                                                    <span class="text-sm px-3 py-1 bg-teal-600 text-white rounded-full shadow-sm">{{ post.category }}</span>
                                                </div>
                                            </div>
                                        {% endfor %}                                    </div>

                                    <div class="flex justify-center items-center space-x-4 mt-6">
                                        {% include 'pagerfanta/tailwind_pagination.html.twig' with {
                                            'pager': posts,
                                            'route': 'app_forum',
                                            'query': query,
                                            'pageParameterName': 'page'
                                        } %}
                                    </div>
                                    <!-- No Posts Found Message -->
                                    <div id="noPostsMessage" class="hidden">
                                        <p>No posts found matching your search/filters.</p>
                                    </div>
                                </div>

                                <!-- Popup Modal -->
                                <div id="postModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center">
                                    <div class="bg-white p-6 rounded-lg shadow-lg w-96 relative animate-fade-in">
                                        <button id="closeModal" class="absolute top-3 right-3 text-gray-700 text-2xl font-bold hover:text-gray-900">&times;</button>
                                        <h2 class="text-2xl font-bold mb-4 text-center text-[#176abc]">New Post</h2>
                                        {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}
                                        <div>
                                            {{ form_label(form.title, null, {'class': 'block text-gray-700 font-semibold'}) }}
                                            {{ form_widget(form.title, {'attr': {'class': 'w-full p-3 border rounded-lg focus:ring-2 focus:ring-[#176abc]'}}) }}
                                            <p class="text-red-500 text-sm">{{ form_errors(form.title) }}</p>
                                        </div>
                                        <div>
                                            {{ form_label(form.content, null, {'class': 'block text-gray-700 font-semibold'}) }}
                                            {{ form_widget(form.content, {'attr': {'class': 'w-full p-3 border rounded-lg focus:ring-2 focus:ring-[#176abc]'}}) }}
                                            <p class="text-red-500 text-sm">{{ form_errors(form.content) }}</p>
                                        </div>
                                        <div>
                                            {{ form_label(form.category, null, {'class': 'block text-gray-700 font-semibold'}) }}
                                            {{ form_widget(form.category, {'attr': {'class': 'w-full p-3 border rounded-lg focus:ring-2 focus:ring-[#176abc]'}}) }}
                                            <p class="text-red-500 text-sm">{{ form_errors(form.category) }}</p>
                                        </div>

                                        <div class="flex justify-center space-x-4 mt-4" style="padding: 5%;">
                                            <button type="button" id="closeModalBtn" class="bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">Cancel</button>
                                            <button type="submit" class="bg-[#176abc] text-white px-4 py-2 rounded-lg hover:bg-[#135a97]">Submit</button>
                                        </div>
                                        {{ form_end(form) }}
                                    </div>
                                </div>

                                <script>
                                    // Toggle Modal
                                    document.getElementById('openModal').addEventListener('click', function() {
                                        document.getElementById('postModal').classList.remove('hidden');
                                    });
                                    document.getElementById('closeModal').addEventListener('click', function() {
                                        document.getElementById('postModal').classList.add('hidden');
                                    });
                                    document.getElementById('closeModalBtn').addEventListener('click', function() {
                                        document.getElementById('postModal').classList.add('hidden');
                                    });

                                    // Toggle Filter Menu
                                    const filterButton = document.getElementById('filterButton');
                                    const filterMenu = document.getElementById('filterMenu');

                                    filterButton.addEventListener('click', function (e) {
                                        e.preventDefault();
                                        filterMenu.classList.toggle('visible');
                                    });

                                    let selectedFilters = {
                                        category: [],
                                        role: [],
                                        comments: [],
                                        time: null,
                                        sort: null,
                                    };
                                    document.querySelectorAll('#filterMenu a[data-filter]').forEach(option => {
                                        option.addEventListener('click', function (e) {
                                            e.preventDefault();
                                            const [filterType, filterValue] = this.getAttribute('data-filter').split(':');

                                            // Toggle filter selection
                                            if (filterType === 'time' || filterType === 'sort') {
                                                // For single-selection filters (time, sort)
                                                if (selectedFilters[filterType] === filterValue) {
                                                    selectedFilters[filterType] = null; // Deselect if already selected
                                                    this.classList.remove('active-filter');
                                                } else {
                                                    // Deselect any previously selected time/sort filter
                                                    document.querySelectorAll(`#filterMenu a[data-filter^="${filterType}:"]`).forEach(otherOption => {
                                                        otherOption.classList.remove('active-filter');
                                                    });
                                                    selectedFilters[filterType] = filterValue; // Select filter
                                                    this.classList.add('active-filter');
                                                }
                                            } else {
                                                // For multi-selection filters (category, role, comments)
                                                if (selectedFilters[filterType].includes(filterValue)) {
                                                    // Deselect if already selected
                                                    selectedFilters[filterType] = selectedFilters[filterType].filter(value => value !== filterValue);
                                                    this.classList.remove('active-filter');
                                                } else {
                                                    // Select filter
                                                    selectedFilters[filterType].push(filterValue);
                                                    this.classList.add('active-filter');
                                                }
                                            }

                                            // Do NOT send AJAX request here
                                        });
                                    });
                                    document.getElementById('applyFilters').addEventListener('click', function (e) {
                                        e.preventDefault();
                                        const searchTerm = document.getElementById('searchInput').value.trim();
                                        fetchFilteredPosts(selectedFilters, searchTerm);
                                    });
                                    function fetchFilteredPosts(filters = {}, searchTerm = '', page = 1) {
                                        const applyFiltersButton = document.getElementById('applyFilters');
                                        const applyFiltersText = document.getElementById('applyFiltersText');
                                        const applyFiltersSpinner = document.getElementById('applyFiltersSpinner');

                                        applyFiltersButton.disabled = true; // Disable the button
                                        applyFiltersText.textContent = 'Applying Filters...'; // Update the button text
                                        applyFiltersSpinner.classList.remove('hidden'); // Show t
                                        fetch('/filter-posts', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify({ filters, search: searchTerm, page }),
                                        })
                                            .then(response => response.json())
                                            .then(data => {
                                                applyFiltersButton.disabled = false;
                                                applyFiltersText.textContent = 'Apply Filters';
                                                applyFiltersSpinner.classList.add('hidden');
                                                // Update the posts list
                                                const postsList = document.getElementById('postsList');
                                                postsList.innerHTML = ''; // Clear existing posts
                                                const noPostsMessage = document.getElementById('noPostsMessage');
                                                if (data.posts.length === 0) {
                                                    noPostsMessage.classList.remove('hidden'); // Show the "No posts found" message
                                                } else {
                                                    noPostsMessage.classList.add('hidden'); // Hide the "No posts found" message
                                                }
                                                data.posts.forEach(post => {
                                                    const postElement = document.createElement('div');
                                                    postElement.className = 'block border p-4 rounded-lg shadow bg-gray-100 hover:bg-gray-200 transition relative';
                                                    postElement.setAttribute('data-id', post.id);
                                                    postElement.innerHTML = `
                <div class="flex justify-between items-center">
                    <a href="/post/${post.id}" class="text-xl font-semibold text-black">${post.title}</a>
                    <div class="flex space-x-2">
                        <a href="/post/edit/${post.id}" class="text-green-500 hover:text-green-700">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="/post/delete/${post.id}" class="text-red-500 hover:text-red-700">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </div>
                </div>
                <p class="text-gray-700 mt-2">${post.content}</p>
                <div class="mt-2 space-x-2">
                    <button onclick="translatePost(${post.id}, 'fr')" class="text-blue-500 hover:text-blue-700">
                        Translate to French
                    </button>
                    <button onclick="translatePost(${post.id}, 'ar')" class="text-blue-500 hover:text-blue-700">
                        Translate to Arabic
                    </button>
                </div>
                <div class="flex items-center space-x-2 mt-2">
                    <p class="text-gray-500 text-sm">Posted by: <strong>${post.author.name} ${post.author.lastname}</strong></p>
                    <span class="text-xs px-2 py-1 bg-blue-500 text-white rounded-full">${post.author.role}</span>
                </div>
                <p class="text-gray-500 text-sm mt-2">Posted on: ${new Date(post.createdAt).toLocaleString()}</p>
                <div class="absolute bottom-4 right-4">
                    <span class="text-sm px-3 py-1 bg-teal-600 text-white rounded-full shadow-sm">${post.category}</span>
                </div>
            `;
                                                    postsList.appendChild(postElement);
                                                });

                                                // Update pagination
                                                const pagination = document.getElementById('pagination');
                                                pagination.innerHTML = data.pagination;

                                                // Attach event listeners to pagination links
                                                attachPaginationListeners();
                                            });
                                    }

//                                         function fetchFilteredPosts(filters = {}, searchTerm = '', page = 1) {
//                                         fetch('/filter-posts', {
//                                             method: 'POST',
//                                             headers: {
//                                                 'Content-Type': 'application/json',
