                                    document.getElementById('searchButton').addEventListener('click', function (e) {
                                        e.preventDefault();
                                        const searchTerm = document.getElementById('searchInput').value.trim();
                                        fetchFilteredPosts(selectedFilters, searchTerm);
                                    });
                                </script>
                                <script>
                                    async function translatePost(postId, targetLanguage) {
                                        const postTitleElement = document.getElementById(`post-title-${postId}`);
                                        const postContentElement = document.getElementById(`post-content-${postId}`);
                                        const postTitle = postTitleElement.innerText;
                                        const postContent = postContentElement.innerText;

                                        try {
                                            const response = await fetch('/translate', {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json',
                                                },
                                                body: JSON.stringify({
                                                    texts: [postTitle, postContent], // Send both title and content
                                                    targetLanguage: targetLanguage,
                                                }),
                                            });

                                            const data = await response.json();
                                            console.log('API Response:', data); // Log the response for debugging

                                            // Ensure the response has the expected structure
                                            if (data.translatedTexts && data.translatedTexts.length === 2) {
                                                const [translatedTitle, translatedContent] = data.translatedTexts;

                                                // Update the title and content with the translated texts
                                                postTitleElement.innerText = translatedTitle;
                                                postContentElement.innerText = translatedContent;
                                            } else {
                                                console.error('Unexpected API response structure:', data);
                                            }
